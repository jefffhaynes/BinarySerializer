<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- Analyzer-only package: no lib/ output; the generator ships under analyzers/dotnet/cs. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <DevelopmentDependency>true</DevelopmentDependency>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <NoWarn>$(NoWarn);RS1038;RS2008</NoWarn>
    <AssemblyName>BinarySerializer.SourceGeneration</AssemblyName>
    <RootNamespace>BinarySerializer.SourceGeneration</RootNamespace>
    <PackageId>BinarySerializer.SourceGeneration</PackageId>
    <Description>Roslyn source generator that emits static registration metadata for BinarySerializer (AOT and trimming support).</Description>
    <Authors>Jeff Haynes</Authors>
    <PackageTags>Serialization;Serializer;Binary;Format;Protocol;SourceGenerator;AOT;Trimming</PackageTags>
    <PackageProjectUrl>https://github.com/jefffhaynes/BinarySerializer</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/jefffhaynes/BinarySerializer</RepositoryUrl>
    <Version>10.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pack the generator assembly as a Roslyn analyzer. -->
    <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>
</Project>
